{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/veydrivo-hero.jpg",
      "destination": "/veyvro-hero.jpg",
      "permanent": true
    },
    {
      "source": "/veydrivo-mark.svg",
      "destination": "/veyvro-mark.svg",
      "permanent": true
    },
    {
      "source": "/drivia-hero.jpg",
      "destination": "/veyvro-hero.jpg",
      "permanent": true
    },
    {
      "source": "/drivia-mark.svg",
      "destination": "/veyvro-mark.svg",
      "permanent": true
    }
  ]
}
