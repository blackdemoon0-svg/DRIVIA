# VEYDRIVO — Server-side AI configuration
# Copy this file to .env.local for local development with `vercel dev`.
# NEVER commit a real API key or expose it in a public VITE_ variable.
#
# Migration note: the legacy DRIVIA_* variable names are still read as a
# fallback by the server, so an environment configured before the rename
# keeps working. New setups should use the VEYDRIVO_* names below.

# Required: Server-side API key for the selected AI provider
VEYDRIVO_AI_API_KEY=

# Optional: AI provider ("openai" | "gemini" | "openai-compatible")
# Defaults to "openai"
VEYDRIVO_AI_PROVIDER=openai

# Optional: Model identifier
# Defaults to "gpt-4.1-mini" when VEYDRIVO_AI_PROVIDER=openai (or "gemini-3.8-flash" when VEYDRIVO_AI_PROVIDER=gemini)
VEYDRIVO_AI_MODEL=gpt-4.1-mini

# Optional: Custom OpenAI-compatible base URL override
# Defaults to "https://api.openai.com/v1" for OpenAI
# VEYDRIVO_AI_BASE_URL=https://api.openai.com/v1
