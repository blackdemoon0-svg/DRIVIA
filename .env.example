# VEYVRO — Server-side AI configuration
# Copy this file to .env.local for local development with `vercel dev`.
# NEVER commit a real API key or expose it in a public VITE_ variable.
#
# Migration note: the previous VEYDRIVO_* names and the original DRIVIA_*
# variable names are still read as fallbacks by the server, so an environment
# configured before the rename keeps working. New setups should use the
# VEYVRO_* names below.

# Required: Server-side API key for the selected AI provider
VEYVRO_AI_API_KEY=

# Optional: AI provider ("openai" | "gemini" | "openai-compatible")
# Defaults to "openai"
VEYVRO_AI_PROVIDER=openai

# Optional: Model identifier
# Defaults to "gpt-4.1-mini" when VEYVRO_AI_PROVIDER=openai (or "gemini-3.8-flash" when VEYVRO_AI_PROVIDER=gemini)
VEYVRO_AI_MODEL=gpt-4.1-mini

# Optional: Custom OpenAI-compatible base URL override
# Defaults to "https://api.openai.com/v1" for OpenAI
# VEYVRO_AI_BASE_URL=https://api.openai.com/v1

# Alias historiques, TOUS OPTIONNELS : le serveur les lit en dernier recours
# pour qu'un environnement configuré avant le renommage continue de marcher.
# Ne renseignez jamais les deux formes à la fois ; VEYVRO_* est prioritaire.
# DRIVIA_AI_API_KEY=
# DRIVIA_AI_PROVIDER=openai
# DRIVIA_AI_MODEL=gpt-4.1-mini
# DRIVIA_AI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Supabase — serveur (OBLIGATOIRES) et navigateur
# ---------------------------------------------------------------------------
# Sans ces trois variables : /api/chat répond 503 `not_configured`, le webhook
# répond 503 « Server is not configured to store subscriptions »,
# /api/supabase-config échoue — et aucun abonnement ne peut être lu ni écrit.
# Elles sont lues UNIQUEMENT côté serveur ; le navigateur reçoit
# l'URL et la clé anonyme par /api/supabase-config, jamais par le bundle.
# Les valeurs ne sont jamais versionnées : ce fichier ne contient que des noms.
# ---------------------------------------------------------------------------

# OBLIGATOIRE — URL du projet, sans slash final.
# Exemple de forme (fictif) : https://votre-projet.supabase.co
SUPABASE_URL=

# OBLIGATOIRE — clé anonyme (publique par conception) : elle ne donne accès
# qu'à ce que les politiques RLS autorisent. Servie au navigateur par
# /api/supabase-config, et utilisée par le serveur pour valider les jetons.
SUPABASE_ANON_KEY=

# OBLIGATOIRE — clé de service : SECRET ABSOLU, côté serveur uniquement.
# Elle contourne RLS : elle ne doit jamais atteindre le navigateur, ni une
# variable VITE_*, ni un journal. Sa valeur ne se versionne jamais.
SUPABASE_SERVICE_ROLE_KEY=

# Production SEO canonical origin — set this in Vercel for the Production target
# only. It is public metadata, not a secret, and must use the primary host.
# VEYVRO_SITE_URL=https://www.veyvro.dev

# ---------------------------------------------------------------------------
# Paddle — abonnement (valeurs PUBLIQUES, exposées au navigateur)
# Ces identifiants sont publiables par conception : token client Paddle et
# price IDs. Ils sont figés au build : après les avoir ajoutés dans Vercel,
# il faut REDÉPLOYER le Preview.
# La clé API Paddle (console Paddle > Developer tools > Authentication) est un
# SECRET serveur : sa VALEUR ne se versionne jamais et ne doit jamais être
# placée dans une variable VITE_* (qui serait inlinée dans le bundle).
# ---------------------------------------------------------------------------

# Token client Paddle (Checkout > Authentication). Requis pour ouvrir le paiement.
# Deux noms sont acceptés :
#  - PADDLE_CLIENT_TOKEN : lu côté serveur par /api/paddle-config. Recommandé,
#    car il s'applique sans reconstruire le bundle (mais sans VITE_, Vite ne
#    l'inline PAS dans le navigateur : c'est la route serveur qui le fournit).
#  - VITE_PADDLE_CLIENT_TOKEN : inliné au build par Vite ; nécessite un
#    redéploiement du Preview après chaque changement.
# Les deux sont des valeurs PUBLIQUES. Ne jamais y placer la clé API Paddle.
PADDLE_CLIENT_TOKEN=
VITE_PADDLE_CLIENT_TOKEN=

# "sandbox" (défaut si absent) ou "production". Toute autre valeur retombe
# prudemment sur sandbox : aucun paiement réel accidentel.
VITE_PADDLE_ENVIRONMENT=sandbox

# Côté serveur, même choix d'environnement. OPTIONNEL : si absent, le serveur
# retombe sur VITE_PADDLE_ENVIRONMENT, puis sur "sandbox". Toute valeur
# inconnue retombe sur sandbox — aucun paiement réel accidentel.
# PADDLE_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# Paddle — webhook et clé API (SECRETS serveur, jamais dans le bundle)
# ---------------------------------------------------------------------------

# OBLIGATOIRE pour /api/paddle-webhook — secret de la destination de
# notification (Paddle > Developer tools > Notifications). Il sert à vérifier
# la signature HMAC de chaque livraison : sans lui, Paddle reçoit 401
# `missing_secret` et aucun abonnement n'est enregistré.
PADDLE_WEBHOOK_SECRET=

# OPTIONNELS — fenêtre de rotation du secret webhook. `_PREVIOUS` n'est accepté
# que si `_PREVIOUS_UNTIL` (date ISO 8601) est encore future ; hors fenêtre, ou
# si les deux valeurs sont identiques, il est ignoré. À retirer une fois la
# rotation terminée.
# PADDLE_WEBHOOK_SECRET_PREVIOUS=
# PADDLE_WEBHOOK_SECRET_PREVIOUS_UNTIL=2026-01-01T00:00:00Z

# OBLIGATOIRE uniquement pour /api/paddle-plan-change (changement de formule) :
# sans elle, cette route répond 503 `not_configured`. SECRET serveur.
# Forme attendue (fictive) : pdl_sdbx_apikey_<valeurs-fictives>
PADDLE_API_KEY=

# Price IDs Paddle, un par formule et par périodicité.
# Tarifs officiels attendus : VEYVRO Plus 7 USD/mois ou 59 USD/an,
# VEYVRO Pro 15 USD/mois ou 129 USD/an. Devise : USD exclusivement.
# Avant paiement, le prix est revérifié auprès de Paddle (devise + montant) :
# un price ID associé à la mauvaise formule bloque le checkout.
#
# Les 4 price IDs Sandbox de VEYVRO sont déjà intégrés dans le code
# (src/lib/paddleCore.ts, SANDBOX_PRICE_IDS) et servent de valeur par défaut
# lorsque l'environnement est "sandbox". Ils ne sont JAMAIS utilisés quand
# l'environnement est production : en production, renseignez ces variables.
# Une variable renseignée ici reste prioritaire sur la valeur Sandbox intégrée.
VITE_PADDLE_PRICE_PLUS_MONTH=
VITE_PADDLE_PRICE_PLUS_YEAR=
VITE_PADDLE_PRICE_PRO_MONTH=
VITE_PADDLE_PRICE_PRO_YEAR=

# Optionnel : page de retour après paiement (HTTPS absolu, sinon ignoré).
# VITE_PADDLE_SUCCESS_URL=https://www.veyvro.dev/merci
